PROJECT_NAME=bingeon
AWS_ACCOUNT_ID=
AWS_REGION=ap-southeast-1
# Comma-separated app URLs, each ending in "/", besides the environment's own
# site, which is always added. The app returns to its own origin after
# sign-in and sign-out, so both lists hold the same URLs.
# development: http://localhost:4200/
# production: empty
CALLBACK_URLS=
LOGOUT_URLS=
# Google OAuth client, for "Sign in with Google" through Cognito only.
# Redirect URI: https://bingeon-<env>.auth.ap-southeast-1.amazoncognito.com/oauth2/idpresponse
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
