PROJECT_NAME=bingeon
AWS_ACCOUNT_ID=
AWS_REGION=ap-southeast-1
# Comma-separated app origins, each ending in "/". The app redirects to its
# own origin after sign-in and sign-out, so both lists hold the same URLs.
# development: http://localhost:4200/
# production adds its own site's URL, so these may be empty.
CALLBACK_URLS=
LOGOUT_URLS=
# Google OAuth client, for "Sign in with Google" through Cognito only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
